# ---------------------------------------------------------------
# Copy to .env.local for development. Set the same keys in Vercel.
# ---------------------------------------------------------------

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-this-to-a-long-random-string"

# Postgres. Leave it unset locally to use the built-in PGlite database
# in db/local — no server needed. Set it in production (Neon, Vercel
# Postgres, Supabase, or your own).
# DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Google sign-in. Leave both unset and the Google buttons simply do not
# appear; mobile + password sign-in keeps working.
# Create credentials at https://console.cloud.google.com/apis/credentials
#   → OAuth client ID → Web application
#   Authorised redirect URIs:
#     http://localhost:3000/api/auth/google/callback
#     https://your-domain.com/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Only needed if the callback URL cannot be worked out automatically —
# for example behind a proxy, or on a custom domain in front of Vercel.
# APP_URL="https://your-domain.com"
